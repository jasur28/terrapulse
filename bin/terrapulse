#!/usr/bin/env python3
"""
TerraPulse management command.

Clean-room equivalent of SeisComp's top-level control command. The same binaries
run everywhere; a machine's ROLE is just a set of enabled modules plus a few
parameters. `terrapulse setup --role <name>` reads etc/roles.json and writes the
site state etc/enabled.json. Module start arguments are not hard-coded here - each
module's etc/init/<module>.py start_args(env) builds them from the role parameters
and config, so the same command drives a field acquisition node and a centre.

  terrapulse setup --role standalone|acquisition|center|processor|playback|gui [--backbone-host H --stations 1,2 ...]
  terrapulse enable  <module>...
  terrapulse disable <module>...
  terrapulse list | status | check
  terrapulse start | stop | restart [module...]   # no names => the enabled daemons, in order
  terrapulse exec <gui-module> [args...]
"""

import argparse
import importlib.util
import json
import os
import platform
import shutil
import signal
import subprocess
import sys
from pathlib import Path

IS_WIN = platform.system() == "Windows"


def root_dir():
    """Install prefix (e.g. /usr/local) or the source-tree root."""
    env = os.environ.get("TP_ROOT")
    return Path(env).resolve() if env else Path(__file__).resolve().parents[1]


# Path layout differs between running from the source tree (<root>/etc, <root>/share,
# <root>/var) and an installed tree (<prefix>/etc/terrapulse, <prefix>/share/terrapulse).
# Detect which, and let TP_CONFIG / TP_SHARE / TP_STATE / TP_RUN / TP_LOG override.
def etc_dir(root):
    env = os.environ.get("TP_CONFIG")
    if env:
        return Path(env).resolve()
    if (root / "etc" / "modules.json").exists():
        return root / "etc"                       # source tree
    if (root / "etc" / "terrapulse" / "modules.json").exists():
        return root / "etc" / "terrapulse"        # installed (<prefix>/etc/terrapulse)
    return root / "etc"


def share_dir(root):
    env = os.environ.get("TP_SHARE")
    if env:
        return Path(env).resolve()
    installed = root / "share" / "terrapulse"
    return installed if installed.is_dir() else root / "share"


def state_dir(root):
    env = os.environ.get("TP_STATE")
    return Path(env).resolve() if env else root / "var"


def load_json(path, default):
    try:
        with path.open("r", encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def load_modules(root):
    return load_json(etc_dir(root) / "modules.json", {}).get("modules", [])


def aliases_path(root):
    return etc_dir(root) / "aliases.json"


def load_aliases(root):
    return load_json(aliases_path(root), {"aliases": {}}).get("aliases", {})


def save_aliases(root, aliases):
    with aliases_path(root).open("w", encoding="utf-8") as f:
        json.dump({"aliases": aliases}, f, indent=2)
        f.write("\n")


def all_modules(root):
    """The catalogue plus per-machine aliases (multi-instance): each alias is a base
    module run under its own name with its own parameters (SeisComp `alias create`)."""
    mods = list(load_modules(root))
    reg = {m["name"]: m for m in mods}
    for name, a in load_aliases(root).items():
        base = reg.get(a.get("module"))
        if not base:
            continue
        mods.append({
            "name": name, "category": "alias", "daemon": True,
            "order": base.get("order", 100), "base": a["module"],
            "params": a.get("params", {}), "description": f"alias of {a['module']}",
        })
    return mods


def load_roles(root):
    return load_json(etc_dir(root) / "roles.json", {}).get("roles", {})


def enabled_path(root):
    return etc_dir(root) / "enabled.json"


def load_enabled(root):
    return load_json(enabled_path(root), {"role": None, "enabled": [], "params": {}})


def save_enabled(root, state):
    with enabled_path(root).open("w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
        f.write("\n")


def build_dir(root):
    env = os.environ.get("TP_BUILD")
    return Path(env).resolve() if env else root / "build" / "Desktop_Qt_6_9_3_MinGW_64_bit-Debug"


def bin_path(root, module):
    candidates = [build_dir(root) / f"{module}.exe", build_dir(root) / module, root / "bin" / module]
    if module in ("tpmap", "tpmv", "tprttv", "tpolv"):
        candidates.insert(0, build_dir(root) / "appTerraPulse.exe")
        candidates.insert(1, build_dir(root) / "appTerraPulse")
    for path in candidates:
        if path.exists():
            return path
    return candidates[0]


# ── config + role parameters exposed to etc/init start_args ────────────────────
def load_config(root):
    """Flat merge of etc/defaults/*.cfg then etc/*.cfg (key = value lines)."""
    cfg = {}
    for d in (etc_dir(root) / "defaults", etc_dir(root)):
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.cfg")):
            for line in f.read_text(encoding="utf-8", errors="ignore").splitlines():
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    return cfg


class Env:
    """Passed to etc/init/<module>.py start_args(env)."""
    def __init__(self, root, state, cfg, role, params):
        self.root = root
        self.state = state
        self._cfg = cfg
        self.role = role
        self._params = params or {}

    def get(self, key, default=None):
        return self._cfg.get(key, default)

    def param(self, key, default=None):
        v = self._params.get(key)
        return default if v in (None, "") else v

    def queue_args(self):
        # A role that sets a queue (e.g. playback) runs a separate pipeline; modules
        # that accept --queue must be told. Unset => the module's default (production).
        q = self.param("queue")
        return ["--queue", q] if q else []

    def path(self, *parts):
        # "var/..." resolves under the state dir so it works installed too.
        if parts and parts[0] == "var":
            return str(self.state.joinpath(*parts[1:]))
        return str(self.root.joinpath(*parts))

    def log(self, message):
        print(message)


def make_env(root):
    enabled = load_enabled(root)
    return Env(root, state_dir(root), load_config(root),
               enabled.get("role"), enabled.get("params", {}))


def load_init(root, name):
    path = etc_dir(root) / "init" / f"{name}.py"
    if not path.exists():
        return None
    spec = importlib.util.spec_from_file_location(f"tpinit_{name}", path)
    mod = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(mod)
    except Exception as exc:  # a broken init file must not take down the command
        print(f"! {name}: init load failed: {exc}")
        return None
    cls = getattr(mod, "Module", None)
    return cls() if cls else None


def env_for(root, module):
    """Env for one module: role params, with the module's own (alias) params on top."""
    enabled = load_enabled(root)
    params = dict(enabled.get("params", {}))
    params.update(module.get("params", {}))
    return Env(root, state_dir(root), load_config(root), enabled.get("role"), params)


def module_args(root, module):
    base = module.get("base", module["name"])       # an alias runs its base module
    init = load_init(root, base)
    if init is not None and hasattr(init, "start_args"):
        try:
            return [str(a) for a in (init.start_args(env_for(root, module)) or [])]
        except Exception as exc:
            print(f"! {module['name']}: start_args failed: {exc}")
    return []


# ── process management (cross-platform) ────────────────────────────────────────
def pid_dir(root):
    path = state_dir(root) / "run"
    path.mkdir(parents=True, exist_ok=True)
    return path


def log_dir(root):
    path = state_dir(root) / "logs"
    path.mkdir(parents=True, exist_ok=True)
    return path


def pid_file(root, module):
    return pid_dir(root) / f"{module}.pid"


def read_pid(root, module):
    path = pid_file(root, module)
    if not path.exists():
        return None
    try:
        return int(path.read_text(encoding="utf-8").strip())
    except ValueError:
        return None


def is_running(pid):
    if not pid:
        return False
    if IS_WIN:
        r = subprocess.run(["tasklist", "/FI", f"PID eq {pid}", "/NH", "/FO", "CSV"],
                           capture_output=True, text=True)
        return f'"{pid}"' in r.stdout
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def terminate(pid):
    if IS_WIN:
        subprocess.run(["taskkill", "/PID", str(pid), "/F"], capture_output=True)
    else:
        os.kill(pid, signal.SIGTERM)


# ── module selection ───────────────────────────────────────────────────────────
def daemon_modules(modules):
    return [m for m in modules if m.get("daemon", False)]


def by_name(modules):
    return {m["name"]: m for m in modules}


def enabled_daemons(root, modules):
    """Enabled daemon modules, in start order."""
    state = load_enabled(root)
    names = state.get("enabled", [])
    reg = by_name(modules)
    picked = [reg[n] for n in names if n in reg and reg[n].get("daemon")]
    return sorted(picked, key=lambda m: m.get("order", 100))


def select_modules(root, modules, names):
    if not names:
        return enabled_daemons(root, modules)
    reg = by_name(modules)
    out = []
    for n in names:
        if n not in reg:
            raise SystemExit(f"unknown module: {n}")
        out.append(reg[n])
    return out


# ── commands ───────────────────────────────────────────────────────────────────
def command_list(root, modules):
    state = load_enabled(root)
    enabled = set(state.get("enabled", []))
    print(f"role: {state.get('role') or '(unset - run: terrapulse setup --role <name>)'}")
    for m in modules:
        mark = "*" if m["name"] in enabled else " "
        kind = "daemon" if m.get("daemon") else "gui"
        print(f" {mark} {m['name']:<13} {kind:<7} {m.get('category',''):<15} {m.get('description','')}")


def command_roles(root):
    for name, role in load_roles(root).items():
        print(f"{name:<12} {role.get('description','')}")
        print(f"             enable: {', '.join(role.get('enable', [])) or '(none)'}")


def command_setup(root, role_name, overrides):
    roles = load_roles(root)
    if role_name not in roles:
        raise SystemExit(f"unknown role '{role_name}' (have: {', '.join(roles)})")
    role = roles[role_name]
    params = dict(role.get("params", {}))
    params.update({k: v for k, v in overrides.items() if v is not None})
    state = {"role": role_name, "enabled": list(role.get("enable", [])), "params": params}
    save_enabled(root, state)
    print(f"role '{role_name}' - {role.get('description','')}")
    print(f"enabled: {', '.join(state['enabled']) or '(none - GUI views via `terrapulse exec`)'}")
    for k, v in params.items():
        print(f"  {k} = {v}")
    print("next: terrapulse start")


def command_toggle(root, names, on):
    state = load_enabled(root)
    s = set(state.get("enabled", []))
    for n in names:
        s.add(n) if on else s.discard(n)
    state["enabled"] = sorted(s)
    save_enabled(root, state)
    print(("enabled: " if on else "disabled: ") + ", ".join(names))


def command_alias(root, ns):
    """Multi-instance: run a module under its own name with its own parameters, so
    a node can carry many sources/partitions (SeisComp `alias create`)."""
    aliases = load_aliases(root)
    if ns.action == "list":
        if not aliases:
            print("no aliases")
        for name, a in aliases.items():
            print(f"{name:<18} -> {a['module']:<12} {a.get('params', {})}")
        return 0
    if ns.action == "remove":
        if aliases.pop(ns.name, None) is not None:
            save_aliases(root, aliases)
            st = load_enabled(root)
            st["enabled"] = [n for n in st.get("enabled", []) if n != ns.name]
            save_enabled(root, st)
            print(f"removed alias {ns.name}")
        else:
            print(f"no such alias: {ns.name}")
        return 0
    # create
    if not ns.name or not ns.module:
        raise SystemExit("usage: terrapulse alias create <name> <module> [--object N --source COM6 --stations 1,2 ...]")
    if ns.module not in {m["name"] for m in load_modules(root)}:
        raise SystemExit(f"unknown base module '{ns.module}'")
    params = {k: v for k, v in {
        "object": ns.object, "station": ns.station, "sensor": ns.sensor,
        "source": ns.source, "stations": ns.stations, "backbone_host": ns.backbone_host,
        "rate": ns.rate, "queue": ns.queue,
    }.items() if v is not None}
    aliases[ns.name] = {"module": ns.module, "params": params}
    save_aliases(root, aliases)
    print(f"alias {ns.name} -> {ns.module}  {params}")
    print(f"enable it: terrapulse enable {ns.name}")
    return 0


def command_check(root, modules):
    errors = 0
    for m in enabled_daemons(root, modules) or daemon_modules(modules):
        exe = bin_path(root, m.get("base", m["name"]))
        if not exe.exists():
            print(f"! {m['name']}: executable not found: {exe}")
            errors += 1
    print("problems found" if errors else "OK")
    return 1 if errors else 0


# OS packages per category (Debian/Ubuntu names). "base" is enough for a headless
# acquisition/processing node (TP_BUILD_GUI=OFF); "gui" adds the QML console deps.
DEP_PACKAGES = {
    "base": ["git", "cmake", "ninja-build", "g++",
             "qt6-base-dev", "qt6-serialport-dev", "libqt6sql6-sqlite"],
    "gui": ["qt6-declarative-dev", "qt6-charts-dev", "libgl1-mesa-dev"],
    "service": [],   # systemd ships with the OS; nothing extra to install
}


def command_install_deps(root, categories, run):
    cats = categories or ["base"]
    pkgs = []
    for c in cats:
        if c not in DEP_PACKAGES:
            print(f"unknown category '{c}' (have: {', '.join(DEP_PACKAGES)})")
            return 1
        pkgs += DEP_PACKAGES[c]
    pkgs = sorted(set(pkgs))

    if IS_WIN:
        print("On Windows dependencies come from the Qt online installer (Qt 6.x MinGW):")
        mods = "Core, Gui, Network, SerialPort, Sql"
        if "gui" in cats:
            mods += ", Quick, QuickControls2, Charts"
        print(f"  Qt modules: {mods}")
        print("  Build tools: CMake + Ninja (bundled with Qt) and the MinGW toolchain.")
        return 0

    if not pkgs:
        print(f"category '{', '.join(cats)}': nothing to install (uses system components).")
        return 0
    if shutil.which("apt-get"):
        cmd = ["sudo", "apt-get", "install", "-y"] + pkgs
    elif shutil.which("dnf"):
        cmd = ["sudo", "dnf", "install", "-y"] + pkgs   # package names differ on Fedora
    else:
        print("no apt-get/dnf found - install these packages manually:")
        print("  " + " ".join(pkgs))
        return 0

    print(" ".join(cmd))
    if run:
        return subprocess.call(cmd)
    print("\n(dry run - add --run to execute)")
    return 0


def command_systemd(root, install):
    """Generate a systemd unit that runs this node's role at boot (like SeisComp's
    init integration). `terrapulse start` launches the enabled daemons and returns;
    ExecStop stops them by pidfile."""
    role = load_enabled(root).get("role") or "standalone"
    py = sys.executable
    cmd = str(Path(__file__).resolve())
    qtlib = os.environ.get("TP_QT_LIB", "")
    ld = (f"Environment=LD_LIBRARY_PATH={qtlib}" if qtlib else
          "# Environment=LD_LIBRARY_PATH=/path/to/qt/lib   # add if Qt is not on the system path")
    unit = (
        "[Unit]\n"
        f"Description=TerraPulse ({role} node)\n"
        "After=network-online.target\n"
        "Wants=network-online.target\n\n"
        "[Service]\n"
        "Type=oneshot\n"
        "RemainAfterExit=yes\n"
        f"Environment=TP_ROOT={root}\n"
        f"{ld}\n"
        f"ExecStart={py} {cmd} start\n"
        f"ExecStop={py} {cmd} stop\n\n"
        "[Install]\n"
        "WantedBy=multi-user.target\n"
    )
    if IS_WIN:
        print("systemd is Linux-only. Generated unit for reference:\n")
        print(unit)
        return 0
    if install:
        dest = "/etc/systemd/system/terrapulse.service"
        try:
            subprocess.run(["sudo", "tee", dest], input=unit, text=True,
                           check=True, stdout=subprocess.DEVNULL)
            subprocess.run(["sudo", "systemctl", "daemon-reload"], check=False)
        except Exception as exc:
            print(f"install failed: {exc}")
            return 1
        print(f"installed {dest}\nenable at boot: sudo systemctl enable --now terrapulse")
        return 0
    print(unit)
    print("# install: terrapulse systemd --install  (writes /etc/systemd/system/terrapulse.service)")
    return 0


def command_printenv(root, modules):
    layout = "source-tree" if (root / "etc" / "modules.json").exists() else \
             ("installed" if (root / "etc" / "terrapulse" / "modules.json").exists() else "unknown")
    enabled = load_enabled(root)
    print(f"TP_ROOT       {root}")
    print(f"layout        {layout}")
    print(f"config (etc)  {etc_dir(root)}")
    print(f"share         {share_dir(root)}")
    print(f"state (var)   {state_dir(root)}")
    print(f"run           {state_dir(root) / 'run'}")
    print(f"logs          {state_dir(root) / 'logs'}")
    print(f"binaries      {build_dir(root)}")
    print(f"role          {enabled.get('role') or '(unset)'}")
    return 0


def command_update_config(root, modules):
    """Validate the configuration (SeisComp's update-config / scchkcfg role):
    every per-sensor binding must name a known module and an existing profile,
    and every enabled daemon must have an executable and shipped defaults."""
    reg = by_name(modules)
    problems = 0
    print(f"configuration root: {root}")

    keydir = etc_dir(root) / "key"
    if not keydir.is_dir():
        print("no bindings (etc/key missing) - all sensors use global config")
    else:
        print("bindings:")
        for kf in sorted(keydir.glob("sensor_*")):
            print(f"  {kf.name}")
            for line in kf.read_text(encoding="utf-8", errors="ignore").splitlines():
                t = line.split("#", 1)[0].strip()
                if not t:
                    continue
                mod, _, prof = t.partition(":")
                mod, prof = mod.strip(), prof.strip()
                if mod not in reg:
                    print(f"    ! unknown module '{mod}'")
                    problems += 1
                elif prof:
                    pf = etc_dir(root) / mod / f"profile_{prof}.cfg"
                    if pf.exists():
                        print(f"    {mod} -> profile '{prof}'")
                    else:
                        print(f"    ! {mod}: profile '{prof}' not found ({pf})")
                        problems += 1
                else:
                    print(f"    {mod} (module config)")

    for m in enabled_daemons(root, modules):
        base = m.get("base", m["name"])
        if not bin_path(root, base).exists():
            print(f"! {m['name']}: executable not found")
            problems += 1
        elif not (etc_dir(root) / "defaults" / f"{base}.cfg").exists():
            print(f"  {m['name']}: no shipped defaults (etc/defaults/{base}.cfg)")

    print(f"\n{'OK - no problems.' if problems == 0 else str(problems) + ' problem(s) found.'}")
    return 1 if problems else 0


def command_status(root, modules):
    state = load_enabled(root)
    enabled = set(state.get("enabled", []))
    for m in modules:
        if m["name"] not in enabled and not read_pid(root, m["name"]):
            continue
        pid = read_pid(root, m["name"])
        if is_running(pid):
            run = f"running pid={pid}"
        elif m.get("oneshot"):
            run = "one-shot (ran at start)"          # expected to have exited
        else:
            run = "stopped"
        print(f"{m['name']:<13} {run}")


def start_one(root, module):
    name = module["name"]
    if not module.get("daemon"):
        print(f"{name}: GUI module - use `terrapulse exec {name}`")
        return
    pid = read_pid(root, name)
    if is_running(pid):
        print(f"{name}: already running pid={pid}")
        return
    exe = bin_path(root, module.get("base", name))       # an alias runs its base exe
    if not exe.exists():
        print(f"{name}: executable not found: {exe}")
        return
    args = module_args(root, module)
    out = open(log_dir(root) / f"{name}.log", "ab")
    err = open(log_dir(root) / f"{name}.err", "ab")
    proc = subprocess.Popen([str(exe)] + args, cwd=str(root), stdout=out, stderr=err)
    pid_file(root, name).write_text(str(proc.pid), encoding="utf-8")
    print(f"{name}: started pid={proc.pid}  {' '.join(args)}")


def stop_one(root, module):
    name = module["name"]
    pid = read_pid(root, name)
    if not is_running(pid):
        print(f"{name}: stopped")
        pid_file(root, name).unlink(missing_ok=True)
        return
    terminate(pid)
    pid_file(root, name).unlink(missing_ok=True)
    print(f"{name}: stopping pid={pid}")


def exec_one(root, name, args):
    exe = bin_path(root, name)
    if not exe.exists():
        raise SystemExit(f"{name}: executable not found: {exe}")
    argv = [str(exe)]
    if name in ("tpmap", "tpmv", "tprttv", "tpolv") and exe.name.startswith("appTerraPulse"):
        argv += ["--view", name]
    argv += args
    if IS_WIN:
        raise SystemExit(subprocess.call(argv))
    os.execv(str(exe), argv)


def main(argv):
    parser = argparse.ArgumentParser(prog="terrapulse")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list")
    sub.add_parser("roles")
    sub.add_parser("check")
    sub.add_parser("update-config")
    sub.add_parser("print-env")
    p = sub.add_parser("systemd")
    p.add_argument("--install", action="store_true")
    p = sub.add_parser("install-deps")
    p.add_argument("categories", nargs="*")     # base | gui | service
    p.add_argument("--run", action="store_true")
    sub.add_parser("status")
    p = sub.add_parser("setup")
    p.add_argument("--role", required=True)
    p.add_argument("--backbone-host", dest="backbone_host")
    p.add_argument("--stations")
    p.add_argument("--source")       # sim | replay | a device (COM6, /dev/ttyUSB0)
    p.add_argument("--rate")
    p.add_argument("--object")
    p.add_argument("--station")
    p.add_argument("--sensor")
    p.add_argument("--inventory")
    p.add_argument("--db")
    for verb in ("enable", "disable"):
        e = sub.add_parser(verb)
        e.add_argument("modules", nargs="+")
    pa = sub.add_parser("alias")
    pa.add_argument("action", choices=["create", "remove", "list"])
    pa.add_argument("name", nargs="?")
    pa.add_argument("module", nargs="?")
    for opt in ("--object", "--station", "--sensor", "--source", "--stations", "--rate", "--queue"):
        pa.add_argument(opt)
    pa.add_argument("--backbone-host", dest="backbone_host")
    for name in ("start", "stop", "restart"):
        p = sub.add_parser(name)
        p.add_argument("modules", nargs="*")
    p = sub.add_parser("exec")
    p.add_argument("module")
    p.add_argument("args", nargs=argparse.REMAINDER)

    ns = parser.parse_args(argv)
    root = root_dir()
    modules = all_modules(root)

    if ns.command == "list":
        command_list(root, modules)
    elif ns.command == "roles":
        command_roles(root)
    elif ns.command == "check":
        return command_check(root, modules)
    elif ns.command == "update-config":
        return command_update_config(root, modules)
    elif ns.command == "print-env":
        return command_printenv(root, modules)
    elif ns.command == "systemd":
        return command_systemd(root, ns.install)
    elif ns.command == "install-deps":
        return command_install_deps(root, ns.categories, ns.run)
    elif ns.command == "status":
        command_status(root, modules)
    elif ns.command == "setup":
        overrides = {
            "backbone_host": ns.backbone_host, "stations": ns.stations, "source": ns.source,
            "rate": ns.rate, "object": ns.object, "station": ns.station, "sensor": ns.sensor,
            "inventory": ns.inventory, "db": ns.db,
        }
        command_setup(root, ns.role, overrides)
    elif ns.command in ("enable", "disable"):
        command_toggle(root, ns.modules, ns.command == "enable")
    elif ns.command == "alias":
        return command_alias(root, ns)
    elif ns.command == "start":
        for m in select_modules(root, modules, ns.modules):
            start_one(root, m)
    elif ns.command == "stop":
        for m in select_modules(root, modules, ns.modules):
            stop_one(root, m)
    elif ns.command == "restart":
        selected = select_modules(root, modules, ns.modules)
        for m in selected:
            stop_one(root, m)
        for m in selected:
            start_one(root, m)
    elif ns.command == "exec":
        exec_one(root, ns.module, ns.args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
